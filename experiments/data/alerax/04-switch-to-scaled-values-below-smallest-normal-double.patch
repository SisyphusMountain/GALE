+// A likelihood below the smallest normal double is stored with fewer and fewer
+// correct digits (down to a single one at 4.9e-324), but its logarithm is still
+// a normal number, so testing the log-likelihood alone does not catch it.
+static bool needsScaledValues(double ll) {
+  static const double minNormalLogLikelihood =
+      std::log(std::numeric_limits<double>::min());
+  return !std::isnormal(ll) || ll < minNormalLogLikelihood;
+}
